    local function createTabButton(name)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 38)
        btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        btn.TextColor3 = Color3.fromRGB(140, 140, 160)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.Text = name
        btn.Parent = sidebar
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            for _, container in pairs(tabContainers) do container.Visible = false end
            for _, b in pairs(tabButtons) do 
                b.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
                b.TextColor3 = Color3.fromRGB(140, 140, 160)
            end
            tabContainers[name].Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(32, 32, 45)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)
        tabButtons[name] = btn
    end

    createTabButton("FARM")
    createTabButton("PLAYER")
    createTabButton("PETS")
    createTabButton("MISC")

    tabContainers["FARM"].Visible = true
    tabButtons["FARM"].BackgroundColor3 = Color3.fromRGB(32, 32, 45)
    tabButtons["FARM"].TextColor3 = Color3.fromRGB(255, 255, 255)
    
    task.delay(0.2, rebuild)
end)
