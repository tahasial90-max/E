local function flyTo(targetPos)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Sicherheits-Teleport zum Vektor 1
    hrp.CFrame = CFrame.new(SAFE_COORDINATES)
    task.wait(0.2)
    
    -- Hoch gehen
    local flightPos = targetPos + Vector3.new(0, 50, 0)
    hrp.CFrame = CFrame.new(flightPos)
    task.wait(0.2)
    
    -- Hinfliegen
    hrp.CFrame = CFrame.new(targetPos) * CFrame.new(0, 3, 0)
    task.wait(0.2)
end

local function stealAndDeliver(uid)
    if state.Busy or not uid then return end
    state.Busy = true
    state.Cancel = false
    statusText.Text = "Starte Steal-Vorgang..."
    
    task.spawn(function()
        local ok, err = pcall(function()
            local eggPos = nil
            for _, rec in ipairs(snapshot()) do
                if rec.Uid == uid then eggPos = rec.BottomCFrame.Position break end
            end
            if not eggPos then statusText.Text = "Ei nicht mehr da!" return end
            
            -- Flug zum Ei (mit Vektor 1 Check)
            flyTo(eggPos)
            
            -- Prompt feuern
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    if obj.Parent and (obj.Parent.Position - eggPos).Magnitude < 15 then
                        if instantGrabEnabled then
                            obj.HoldDuration = 0
                        end
                        pcall(function() fireproximityprompt(obj) end)
                    end
                end
            end
            task.wait(0.3)
            
            -- Zurück fliegen zur Safezone
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(SAFE_COORDINATES)
            end
            statusText.Text = "✅ Erfolgreich geklaut!"
            
            task.wait(1) -- Kurz warten, bevor das nächste kommt
        end)
        if not ok then statusText.Text = "❌ Fehler: " .. tostring(err) end
        state.Busy = false
        
